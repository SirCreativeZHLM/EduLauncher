#!/usr/bin/env bash
# EduLauncher: runs the Android build of Minecraft Education natively on Linux.
#
#   edulauncher                 start the game (asks for the APK the first time)
#   edulauncher download        download (or update) the game from Google Play
#   edulauncher import [file]   install or update the game from an .apk/.apks/.xapk/.apkm
#   edulauncher signout         forget the saved school account
#   edulauncher info            show installed version and paths
#   edulauncher -- <args>       start the game passing extra mcpelauncher-client flags
set -euo pipefail
shopt -s globstar nullglob

APP_ID="io.github.sircreativezhlm.EduLauncher"
DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/edulauncher"
GAME_DIR="$DATA_ROOT/game"
PROFILE_DIR="$DATA_ROOT/profile"

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIBEXEC_DIR="${EDULAUNCHER_LIBEXEC:-}"
if [[ -z "$LIBEXEC_DIR" ]]; then
    for d in "$SELF_DIR" "$SELF_DIR/../lib/edulauncher/bin" /usr/lib/edulauncher/bin /app/lib/edulauncher/bin; do
        if [[ -x "$d/mcpelauncher-client" ]]; then LIBEXEC_DIR="$(cd "$d" && pwd)"; break; fi
    done
fi

case "${EDULAUNCHER_ABI:-$(uname -m)}" in
    x86_64|amd64) ABI="x86_64" ;;
    aarch64|arm64) ABI="arm64-v8a" ;;
    i?86) ABI="x86" ;;
    armv7*) ABI="armeabi-v7a" ;;
    *) ABI="$(uname -m)" ;;
esac

SHARE_DIR=""
for d in "$SELF_DIR/../share/edulauncher" /usr/share/edulauncher /app/share/edulauncher; do
    if [[ -d "$d/play" ]]; then SHARE_DIR="$(cd "$d" && pwd)"; break; fi
done

# A game copy shipped inside the package, used until the user imports their own
BUNDLED_GAME=""
for d in "$SELF_DIR/../share/edulauncher/game" /usr/share/edulauncher/game /app/share/edulauncher/game; do
    if [[ -f "$d/lib/$ABI/libminecraftpe.so" ]]; then BUNDLED_GAME="$(cd "$d" && pwd)"; break; fi
done
if [[ -n "$BUNDLED_GAME" && ! -f "$GAME_DIR/lib/$ABI/libminecraftpe.so" ]]; then GAME_DIR="$BUNDLED_GAME"; fi

have() { command -v "$1" >/dev/null 2>&1; }

say() {
    echo "$1" >&2
    # Only show a dialog when not started from a terminal and there is a display to show it on
    if [[ ! -t 2 && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        if [[ -x "$LIBEXEC_DIR/edulauncher-signin" ]]; then "$LIBEXEC_DIR/edulauncher-signin" --message "$1" || true
        elif have zenity; then zenity --info --title="Minecraft Education" --text="$1" || true
        elif have kdialog; then kdialog --title "Minecraft Education" --msgbox "$1" || true
        fi
    fi
}

die() { say "$1"; exit 1; }

pick_apk() {
    if [[ -x "$LIBEXEC_DIR/edulauncher-signin" ]]; then "$LIBEXEC_DIR/edulauncher-signin" --pick-apk
    elif have zenity; then zenity --file-selection --title="Choose the Minecraft Education APK" --file-filter="Android app | *.apk *.apks *.xapk *.apkm *.zip"
    elif have kdialog; then kdialog --getopenfilename "$HOME" "*.apk *.apks *.xapk *.apkm *.zip"
    else return 1
    fi
}

# Extracts the parts the launcher needs (manifest, assets, native libs) from one APK
extract_apk() {
    local apk="$1" dest="$2"
    unzip -qo "$apk" 'AndroidManifest.xml' 'assets/*' "lib/$ABI/*" -d "$dest" 2>/dev/null || [[ $? -eq 11 ]] || return 1
}

import_game() {
    local src="$1"
    [[ -e "$src" ]] || die "File not found: $src"
    have unzip || die "unzip is required to import the game."

    local work; work="$(mktemp -d "${TMPDIR:-/tmp}/edulauncher.XXXXXX")"
    trap 'rm -rf "$work"' RETURN
    local stage="$work/game"
    mkdir -p "$stage"

    local bundle="$work/bundle"
    if [[ -d "$src" ]]; then
        # Folder of split APKs, as downloaded from Google Play
        bundle="$src"
    elif unzip -Z1 "$src" 2>/dev/null | grep -qE '\.apk$'; then
        # Split bundle (.apks/.xapk/.apkm): base.apk + split_config.<abi>.apk + asset packs
        echo "Unpacking app bundle..."
        mkdir -p "$bundle"
        unzip -qo "$src" '*.apk' -d "$bundle"
    fi
    if [[ -d "$bundle" ]]; then
        local base=""
        for apk in "$bundle"/**/*.apk; do
            [[ -f "$apk" ]] || continue
            if [[ "$(basename "$apk")" == "base.apk" ]] || unzip -Z1 "$apk" 2>/dev/null | grep -qx 'classes.dex'; then base="$apk"; fi
        done
        [[ -n "$base" ]] || die "This bundle has no base APK."
        extract_apk "$base" "$stage" || die "Could not read $base"
        for apk in "$bundle"/**/*.apk; do
            [[ -f "$apk" && "$apk" != "$base" ]] || continue
            # Splits carry their own manifest, keep the one from the base APK
            mv "$stage/AndroidManifest.xml" "$work/manifest.keep"
            extract_apk "$apk" "$stage" || true
            mv -f "$work/manifest.keep" "$stage/AndroidManifest.xml"
        done
    else
        echo "Unpacking APK..."
        extract_apk "$src" "$stage" || die "Could not read $src. Is it an APK file?"
    fi

    if [[ ! -f "$stage/lib/$ABI/libminecraftpe.so" ]]; then
        local found
        found="$( { unzip -Z1 "$src"; for a in "$bundle"/**/*.apk; do unzip -Z1 "$a"; done; } 2>/dev/null \
            | grep -oE '^lib/[^/]+' | sed 's|^lib/||' | sort -u | tr '\n' ' ' || true)"
        die "This APK has no $ABI build of the game (it contains: ${found:-nothing}).
Minecraft Education needs the $ABI version, the one Google Play gives Chromebooks."
    fi
    # The binary manifest stores strings as UTF-16, drop the NUL bytes before searching
    if ! tr -d '\0' < "$stage/AndroidManifest.xml" 2>/dev/null | grep -aq "minecraftedu"; then
        echo "Warning: this does not look like Minecraft Education (com.mojang.minecraftedu)." >&2
    fi

    GAME_DIR="$DATA_ROOT/game"
    mkdir -p "$DATA_ROOT"
    rm -rf "$GAME_DIR.old"
    [[ -d "$GAME_DIR" ]] && mv "$GAME_DIR" "$GAME_DIR.old"
    mv "$stage" "$GAME_DIR"
    rm -rf "$GAME_DIR.old"
    echo "Installed Minecraft Education into $GAME_DIR"
}

# Downloads the game for this CPU from Google Play with an anonymous account from Aurora Store's token dispenser
download_game() {
    local props="$SHARE_DIR/play/$ABI.properties"
    [[ -f "$props" ]] || die "Downloading is not supported for $ABI."
    local apkeep="$LIBEXEC_DIR/apkeep"
    [[ -x "$apkeep" ]] || apkeep="$(command -v apkeep)" || die "apkeep is required to download the game."
    have curl || die "curl is required to download the game."

    echo "Getting an anonymous Google Play account..."
    local json auth email token
    json="$(awk 'index($0, "=") && $0 !~ /^[#\[]/ {
            k = substr($0, 1, index($0, "=") - 1); v = substr($0, index($0, "=") + 1)
            gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v)
            printf "%s\"%s\":\"%s\"", (n++ ? "," : "{"), k, v
        } END { print "}" }' "$props")"
    auth="$(curl -fsS --max-time 60 -X POST -H 'User-Agent: com.aurora.store-4.6.1-70' -H 'Content-Type: application/json' \
        --data "$json" https://auroraoss.com/api/auth)" || die "Could not reach the Google Play account service. Check your internet connection."
    email="$(sed -n 's/.*"email" *: *"\([^"]*\)".*/\1/p' <<<"$auth")"
    token="$(sed -n 's/.*"authToken" *: *"\([^"]*\)".*/\1/p' <<<"$auth")"
    [[ -n "$email" && -n "$token" ]] || die "The Google Play account service did not return an account. Try again later."

    local work; work="$(mktemp -d "${TMPDIR:-/tmp}/edulauncher-dl.XXXXXX")"
    echo "Downloading Minecraft Education from Google Play (about 1 GB)..."
    "$apkeep" -a com.mojang.minecraftedu -d google-play -o "device=default,device_properties_file=$props,split_apk=true" \
        -e "$email" --auth-token "$token" --accept-tos "$work" || true
    if [[ ! -d "$work/com.mojang.minecraftedu" ]]; then
        rm -rf "$work"
        die "Google Play did not send the game. Try again later, or use: edulauncher import <file>"
    fi
    import_game "$work/com.mojang.minecraftedu"
    rm -rf "$work"
}

need_client() {
    [[ -n "$LIBEXEC_DIR" ]] || die "mcpelauncher-client was not found. Set EDULAUNCHER_LIBEXEC to the folder that has it."
}

run_game() {
    need_client
    if [[ ! -f "$GAME_DIR/lib/$ABI/libminecraftpe.so" ]]; then
        if [[ -n "$SHARE_DIR" ]]; then
            say "Minecraft Education is not installed yet. It will now be downloaded from Google Play (about 1 GB), this takes a few minutes."
            ( download_game ) || true
        fi
        if [[ ! -f "$DATA_ROOT/game/lib/$ABI/libminecraftpe.so" ]]; then
            local apk
            if ! apk="$(pick_apk)" || [[ -z "$apk" ]]; then
                die "Minecraft Education is not installed yet. Run: edulauncher download"
            fi
            import_game "$apk"
        fi
        GAME_DIR="$DATA_ROOT/game"
    fi
    mkdir -p "$PROFILE_DIR"
    export PATH="$LIBEXEC_DIR:$PATH"
    exec "$LIBEXEC_DIR/mcpelauncher-client" -dg "$GAME_DIR/" -dd "$PROFILE_DIR/" "$@"
}

case "${1:-}" in
    import)
        if [[ $# -ge 2 ]]; then
            import_game "$2"
        else
            apk="$(pick_apk)" && [[ -n "$apk" ]] || die "Usage: edulauncher import <file.apk|.apks|.xapk|.apkm>"
            import_game "$apk"
            say "Minecraft Education is installed. Start it from your app menu."
        fi ;;
    download|update)
        download_game ;;
    signout|sign-out|logout)
        rm -f "$PROFILE_DIR/edu_auth.json"
        rm -rf "$DATA_ROOT/signin"
        echo "Signed out." ;;
    info)
        echo "App id:    $APP_ID"
        echo "ABI:       $ABI"
        echo "Launcher:  ${LIBEXEC_DIR:-not found}"
        echo "Game dir:  $GAME_DIR"
        echo "Profile:   $PROFILE_DIR"
        if [[ "$GAME_DIR" == "$BUNDLED_GAME" ]]; then echo "Game:      bundled ($GAME_DIR)"
        elif [[ -f "$GAME_DIR/lib/$ABI/libminecraftpe.so" ]]; then echo "Game:      installed"; else echo "Game:      not installed"; fi
        if [[ -f "$PROFILE_DIR/edu_auth.json" ]]; then echo "Account:   signed in"; else echo "Account:   signed out"; fi ;;
    -h|--help|help)
        sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    --)
        shift; run_game "$@" ;;
    *)
        run_game "$@" ;;
esac

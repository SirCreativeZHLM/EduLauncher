new file mode 100644
index 0000000..c9fcdb5
--- /dev/null
+++ b/src/edu/edu_auth.cpp
@@ -0,0 +1,401 @@
+#include "edu_auth.h"
+
+#include <EnvPathUtil.h>
+#include <curl/curl.h>
+#include <log.h>
+#include <mcpelauncher/path_helper.h>
+#include <nlohmann/json.hpp>
+#include <openssl/rand.h>
+#include <openssl/sha.h>
+
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vector>
+
+static long long nowSeconds() {
+    return std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+static std::string base64Url(unsigned char const* data, size_t len) {
+    static const char* tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    std::string out;
+    size_t i = 0;
+    for(; i + 2 < len; i += 3) {
+        unsigned v = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2];
+        out += tbl[(v >> 18) & 63];
+        out += tbl[(v >> 12) & 63];
+        out += tbl[(v >> 6) & 63];
+        out += tbl[v & 63];
+    }
+    if(len - i == 1) {
+        unsigned v = data[i] << 16;
+        out += tbl[(v >> 18) & 63];
+        out += tbl[(v >> 12) & 63];
+    } else if(len - i == 2) {
+        unsigned v = (data[i] << 16) | (data[i + 1] << 8);
+        out += tbl[(v >> 18) & 63];
+        out += tbl[(v >> 12) & 63];
+        out += tbl[(v >> 6) & 63];
+    }
+    return out;
+}
+
+static std::string base64UrlDecode(std::string const& in) {
+    std::string out;
+    unsigned v = 0;
+    int bits = 0;
+    for(char c : in) {
+        int d;
+        if(c >= 'A' && c <= 'Z')
+            d = c - 'A';
+        else if(c >= 'a' && c <= 'z')
+            d = c - 'a' + 26;
+        else if(c >= '0' && c <= '9')
+            d = c - '0' + 52;
+        else if(c == '-' || c == '+')
+            d = 62;
+        else if(c == '_' || c == '/')
+            d = 63;
+        else
+            continue;
+        v = (v << 6) | d;
+        bits += 6;
+        if(bits >= 8) {
+            bits -= 8;
+            out += (char)((v >> bits) & 0xff);
+        }
+    }
+    return out;
+}
+
+// The account name from an id_token, which is only decoded, the token came straight from the token endpoint
+static std::string userFromIdToken(std::string const& idToken) {
+    auto a = idToken.find('.');
+    auto b = idToken.find('.', a + 1);
+    if(a == std::string::npos || b == std::string::npos)
+        return {};
+    try {
+        auto claims = nlohmann::json::parse(base64UrlDecode(idToken.substr(a + 1, b - a - 1)));
+        for(auto key : {"preferred_username", "upn", "email"})
+            if(claims.contains(key) && claims[key].is_string())
+                return claims[key].get<std::string>();
+    } catch(...) {
+    }
+    return {};
+}
+
+static std::string urlEncode(std::string const& s) {
+    std::string out;
+    char buf[4];
+    for(unsigned char c : s) {
+        if(isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
+            out += c;
+        } else {
+            snprintf(buf, sizeof(buf), "%%%02X", c);
+            out += buf;
+        }
+    }
+    return out;
+}
+
+static std::string urlDecode(std::string const& s) {
+    std::string out;
+    for(size_t i = 0; i < s.size(); i++) {
+        if(s[i] == '%' && i + 2 < s.size()) {
+            out += (char)std::stoi(s.substr(i + 1, 2), nullptr, 16);
+            i += 2;
+        } else if(s[i] == '+') {
+            out += ' ';
+        } else {
+            out += s[i];
+        }
+    }
+    return out;
+}
+
+static std::string queryParam(std::string const& url, std::string const& name) {
+    auto q = url.find_first_of("?#");
+    if(q == std::string::npos)
+        return {};
+    std::string rest = url.substr(q + 1);
+    size_t pos = 0;
+    while(pos <= rest.size()) {
+        auto end = rest.find_first_of("&#", pos);
+        if(end == std::string::npos)
+            end = rest.size();
+        auto part = rest.substr(pos, end - pos);
+        auto eq = part.find('=');
+        if(eq != std::string::npos && part.substr(0, eq) == name)
+            return urlDecode(part.substr(eq + 1));
+        pos = end + 1;
+    }
+    return {};
+}
+
+static size_t curlWrite(char* ptr, size_t size, size_t nmemb, void* userdata) {
+    ((std::string*)userdata)->append(ptr, size * nmemb);
+    return size * nmemb;
+}
+
+static std::string postForm(std::string const& url, std::string const& form, long& status) {
+    CURL* curl = curl_easy_init();
+    if(!curl)
+        throw std::runtime_error("Could not initialize curl");
+    std::string response;
+    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl, CURLOPT_POSTFIELDS, form.c_str());
+    curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE, (long)form.size());
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, curlWrite);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &response);
+    curl_easy_setopt(curl, CURLOPT_TIMEOUT, 60L);
+    auto ret = curl_easy_perform(curl);
+    status = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    curl_easy_cleanup(curl);
+    if(ret != CURLE_OK)
+        throw std::runtime_error(std::string("Network error while signing in: ") + curl_easy_strerror(ret));
+    return response;
+}
+
+// Runs argv without a shell and returns its stdout, or throws when it exits non-zero.
+static std::string runCapture(std::vector<std::string> const& argv) {
+    int out[2];
+    if(pipe(out) != 0)
+        throw std::runtime_error("pipe() failed");
+    pid_t pid = fork();
+    if(pid == 0) {
+        dup2(out[1], STDOUT_FILENO);
+        close(out[0]);
+        close(out[1]);
+        std::vector<char*> cargv;
+        for(auto& a : argv)
+            cargv.push_back((char*)a.c_str());
+        cargv.push_back(nullptr);
+        execvp(cargv[0], cargv.data());
+        _exit(127);
+    }
+    close(out[1]);
+    if(pid < 0) {
+        close(out[0]);
+        throw std::runtime_error("fork() failed");
+    }
+    std::string result;
+    char buf[4096];
+    ssize_t r;
+    while((r = read(out[0], buf, sizeof(buf))) > 0)
+        result.append(buf, r);
+    close(out[0]);
+    int status = 0;
+    waitpid(pid, &status, 0);
+    if(!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        throw std::runtime_error(argv[0] + " exited with status " + std::to_string(WEXITSTATUS(status)));
+    while(!result.empty() && (result.back() == '\n' || result.back() == '\r'))
+        result.pop_back();
+    return result;
+}
+
+EduAuth& EduAuth::instance() {
+    static EduAuth auth;
+    return auth;
+}
+
+std::string EduAuth::cachePath() {
+    return PathHelper::getPrimaryDataDirectory() + "edu_auth.json";
+}
+
+std::string EduAuth::scopeFor(std::string const& target) {
+    if(target.empty())
+        return SCOPE;
+    auto resource = target;
+    while(!resource.empty() && resource.back() == '/')
+        resource.pop_back();
+    if(resource.find("/.default") == std::string::npos)
+        resource += "/.default";
+    return resource + " offline_access openid profile";
+}
+
+void EduAuth::load() {
+    if(loaded)
+        return;
+    loaded = true;
+    std::ifstream f(cachePath());
+    if(!f)
+        return;
+    try {
+        auto js = nlohmann::json::parse(f);
+        refreshToken = js.value("refresh_token", "");
+        user = js.value("user", "");
+        if(js.contains("tokens"))
+            for(auto& [scope, t] : js["tokens"].items())
+                tokens[scope] = Token{t.value("access_token", ""), t.value("expires_at", 0LL)};
+        else if(js.contains("access_token"))
+            tokens[SCOPE] = Token{js.value("access_token", ""), js.value("expires_at", 0LL)};
+    } catch(std::exception& e) {
+        Log::warn("EduAuth", "Ignoring unreadable token cache: %s", e.what());
+    }
+}
+
+void EduAuth::save() {
+    auto js = nlohmann::json{{"refresh_token", refreshToken}, {"user", user}, {"tokens", nlohmann::json::object()}};
+    for(auto& [scope, t] : tokens)
+        js["tokens"][scope] = {{"access_token", t.accessToken}, {"expires_at", t.expiresAt}};
+    auto path = cachePath();
+    {
+        std::ofstream f(path, std::ios::trunc);
+        f << js.dump();
+    }
+    chmod(path.c_str(), 0600);
+}
+
+void EduAuth::applyTokenResponse(std::string const& body, std::string const& scope) {
+    auto js = nlohmann::json::parse(body);
+    tokens[scope] = Token{js.at("access_token").get<std::string>(), nowSeconds() + js.value("expires_in", 3600LL)};
+    if(js.contains("refresh_token"))
+        refreshToken = js["refresh_token"].get<std::string>();
+    if(js.contains("id_token")) {
+        auto name = userFromIdToken(js["id_token"].get<std::string>());
+        if(!name.empty())
+            user = name;
+    }
+    save();
+}
+
+void EduAuth::redeemRefreshToken(std::string const& scope) {
+    long status;
+    auto body = postForm(std::string(AUTHORITY) + "token",
+                         "client_id=" + urlEncode(CLIENT_ID) + "&grant_type=refresh_token&refresh_token=" + urlEncode(refreshToken) + "&scope=" + urlEncode(scope),
+                         status);
+    if(status != 200) {
+        Log::warn("EduAuth", "Refreshing the sign-in for %s failed (%ld): %s", scope.c_str(), status, body.c_str());
+        // A refresh token that is invalid for every resource has to go, one that only lacks consent for this one stays
+        if(body.find("invalid_grant") != std::string::npos && scope == SCOPE) {
+            refreshToken.clear();
+            save();
+        }
+        throw InteractionRequired("Saved sign-in expired");
+    }
+    applyTokenResponse(body, scope);
+}
+
+std::string EduAuth::showSignInWindow(std::string const& url) {
+    // 1. Our own Qt WebEngine window which returns the final redirect url on stdout
+    std::string signin;
+    if(EnvPathUtil::findInPath("edulauncher-signin", signin, EnvPathUtil::getAppDir().c_str()) || EnvPathUtil::findInPath("edulauncher-signin", signin)) {
+        Log::info("EduAuth", "Opening sign-in window");
+        try {
+            return runCapture({signin, url, REDIRECT_URI});
+        } catch(std::exception& e) {
+            Log::info("EduAuth", "Sign-in window closed: %s", e.what());
+            return {};
+        }
+    }
+    // 2. System browser plus a dialog to paste the final url
+    Log::warn("EduAuth", "edulauncher-signin not found, using the system browser");
+    std::string tool;
+    if(EnvPathUtil::findInPath("xdg-open", tool))
+        try {
+            runCapture({tool, url});
+        } catch(...) {
+        }
+    std::string text = "Sign in with your school account in the browser window that just opened.\n"
+                       "When the page goes blank, copy the full address from the address bar and paste it here.";
+    if(EnvPathUtil::findInPath("zenity", tool))
+        return runCapture({tool, "--entry", "--title=Minecraft Education sign-in", "--width=600", "--text=" + text});
+    if(EnvPathUtil::findInPath("kdialog", tool))
+        return runCapture({tool, "--title", "Minecraft Education sign-in", "--inputbox", text});
+    // 3. Terminal
+    std::cout << "Open this address in a web browser and sign in:\n" << url << "\n" << text << "\n> " << std::flush;
+    std::string line;
+    std::getline(std::cin, line);
+    return line;
+}
+
+void EduAuth::interactiveSignIn(std::string const& userHint) {
+    unsigned char verifierBytes[32];
+    RAND_bytes(verifierBytes, sizeof(verifierBytes));
+    auto verifier = base64Url(verifierBytes, sizeof(verifierBytes));
+    unsigned char hash[SHA256_DIGEST_LENGTH];
+    SHA256((unsigned char const*)verifier.data(), verifier.size(), hash);
+    auto challenge = base64Url(hash, sizeof(hash));
+    unsigned char stateBytes[16];
+    RAND_bytes(stateBytes, sizeof(stateBytes));
+    auto state = base64Url(stateBytes, sizeof(stateBytes));
+
+    auto url = std::string(AUTHORITY) + "authorize?client_id=" + urlEncode(CLIENT_ID) + "&response_type=code&redirect_uri=" + urlEncode(REDIRECT_URI) +
+               "&response_mode=query&scope=" + urlEncode(SCOPE) + "&code_challenge=" + challenge + "&code_challenge_method=S256&state=" + state +
+               (userHint.empty() ? "&prompt=select_account" : "&login_hint=" + urlEncode(userHint));
+
+    auto result = showSignInWindow(url);
+    if(result.empty())
+        throw Cancelled("Sign-in was cancelled");
+    auto error = queryParam(result, "error");
+    if(!error.empty())
+        throw std::runtime_error("Microsoft sign-in failed: " + error + " " + queryParam(result, "error_description"));
+    if(queryParam(result, "state") != state)
+        throw std::runtime_error("Sign-in response did not match the request");
+    auto code = queryParam(result, "code");
+    if(code.empty())
+        throw std::runtime_error("Sign-in did not return an authorization code");
+
+    long status;
+    auto body = postForm(std::string(AUTHORITY) + "token",
+                         "client_id=" + urlEncode(CLIENT_ID) + "&grant_type=authorization_code&code=" + urlEncode(code) + "&redirect_uri=" + urlEncode(REDIRECT_URI) +
+                             "&code_verifier=" + verifier + "&scope=" + urlEncode(SCOPE),
+                         status);
+    if(status != 200) {
+        Log::error("EduAuth", "Token request failed (%ld): %s", status, body.c_str());
+        std::string description;
+        try {
+            description = nlohmann::json::parse(body).value("error_description", "");
+        } catch(...) {
+        }
+        throw std::runtime_error("Microsoft rejected the sign-in. " + description);
+    }
+    applyTokenResponse(body, SCOPE);
+}
+
+EduAuth::Token EduAuth::acquireToken(bool allowInteractive, std::string const& target, std::string const& userHint) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(auto env = getenv("MCEE_ACCESS_TOKEN"))
+        return Token{env, nowSeconds() + 3600};
+    load();
+    auto scope = scopeFor(target);
+    auto it = tokens.find(scope);
+    if(it != tokens.end() && !it->second.accessToken.empty() && it->second.expiresAt - 300 > nowSeconds())
+        return it->second;
+    if(!refreshToken.empty()) {
+        try {
+            redeemRefreshToken(scope);
+            return tokens[scope];
+        } catch(InteractionRequired& e) {
+            Log::warn("EduAuth", "%s", e.what());
+        }
+    }
+    if(!allowInteractive)
+        throw InteractionRequired("Please sign in again");
+    interactiveSignIn(userHint);
+    if(scope != SCOPE)
+        redeemRefreshToken(scope);
+    return tokens[scope];
+}
+
+std::string EduAuth::userName() {
+    std::lock_guard<std::mutex> lock(mutex);
+    load();
+    return user;
+}
+
+void EduAuth::signOut() {
+    std::lock_guard<std::mutex> lock(mutex);
+    loaded = true;
+    tokens.clear();
+    refreshToken.clear();
+    user.clear();
+    unlink(cachePath().c_str());
+}

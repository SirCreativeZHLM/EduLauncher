+    std::shared_ptr<FakeJni::JString> getUserHint();
+    FakeJni::JBoolean getCancelled();
+    FakeJni::JBoolean hasError();
+    std::shared_ptr<FakeJni::JString> getErrorString();
+    FakeJni::JInt getErrorStatus();
+    FakeJni::JInt getErrorSubStatus();
+    std::shared_ptr<FakeJni::JString> getSignOutError();
+    // Older game versions
+    std::shared_ptr<FakeJni::JString> getLastError();
+};
+
+namespace EduSupport {
+
+// MainActivity.getSecureStorageKey / setSecureStorageKey, persisted in the data dir
+std::string getSecureStorageKey(std::string const& key);
+void setSecureStorageKey(std::string const& key, std::string const& value);
+
+// Education sign-in requests are rejected for the "Linux()" platform, report an Android device instead.
+bool isEduServiceUrl(std::string const& url);
+// Returns the rewritten body, keeps it at most maxSize bytes (padded with spaces) when maxSize != 0.
+std::string rewriteRequestBody(std::string const& url, std::string const& body, size_t maxSize = 0);
+
+void addGameHooks(std::vector<mcpelauncher_hook_t>& hooks);
+
+// Stubs for libc and libandroid functions that newer Education builds import but upstream does not provide yet.
+// Existing entries are kept.
+void addLibCSymbols(std::unordered_map<std::string, void*>& syms);
+void addAndroidSymbols(std::unordered_map<std::string, void*>& syms);
+
+}  // namespace EduSupport

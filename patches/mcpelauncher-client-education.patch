new file mode 100644
index 0000000..240dcbe
--- /dev/null
+++ b/src/edu/edu_auth.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+
+// Microsoft Entra ID (Azure AD) sign-in for Minecraft Education.
+// The game asks ActiveDirectorySignIn for an access token for the
+// meeservices.minecraft.net resource and exchanges it with
+// login.minecrafteduservices.com itself.
+class EduAuth {
+public:
+    static constexpr const char* CLIENT_ID = "b36b1432-1a1c-4c82-9b76-24de1cab42f2";
+    static constexpr const char* AUTHORITY = "https://login.microsoftonline.com/common/oauth2/v2.0/";
+    static constexpr const char* REDIRECT_URI = "https://login.microsoftonline.com/common/oauth2/nativeclient";
+    static constexpr const char* SCOPE = "https://meeservices.minecraft.net/.default offline_access openid profile";
+
+    struct Token {
+        std::string accessToken;
+        long long expiresAt = 0;  // seconds since the epoch
+    };
+    // The user closed the sign-in window
+    struct Cancelled : std::runtime_error {
+        using std::runtime_error::runtime_error;
+    };
+    // There is no saved sign-in that works without asking the user
+    struct InteractionRequired : std::runtime_error {
+        using std::runtime_error::runtime_error;
+    };
+
+    static EduAuth& instance();
+
+    // Returns a valid access token for target (a resource such as https://meeservices.minecraft.net, empty for the
+    // default one), refreshing or asking the user to sign in when needed.
+    // Throws std::runtime_error with a user facing message on failure.
+    Token acquireToken(bool allowInteractive, std::string const& target = {}, std::string const& userHint = {});
+    // The signed in account (user@school.edu), empty when nobody signed in yet
+    std::string userName();
+
+    void signOut();
+
+private:
+    std::mutex mutex;
+    std::map<std::string, Token> tokens;  // by scope
+    std::string refreshToken;
+    std::string user;
+    bool loaded = false;
+
+    static std::string scopeFor(std::string const& target);
+    std::string cachePath();
+    void load();
+    void save();
+    void applyTokenResponse(std::string const& body, std::string const& scope);
+    void redeemRefreshToken(std::string const& scope);
+    void interactiveSignIn(std::string const& userHint);
+    std::string showSignInWindow(std::string const& url);

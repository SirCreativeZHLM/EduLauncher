@@ -0,0 +1,39 @@
+#pragma once
+
+#include <mutex>
+#include <string>
+
+// Microsoft Entra ID (Azure AD) sign-in for Minecraft Education.
+// The game asks ActiveDirectorySignIn for an access token for the
+// meeservices.minecraft.net resource and exchanges it with
+// login.minecrafteduservices.com itself.
+class EduAuth {
+public:
+    static constexpr const char* CLIENT_ID = "b36b1432-1a1c-4c82-9b76-24de1cab42f2";
+    static constexpr const char* AUTHORITY = "https://login.microsoftonline.com/common/oauth2/v2.0/";
+    static constexpr const char* REDIRECT_URI = "https://login.microsoftonline.com/common/oauth2/nativeclient";
+    static constexpr const char* SCOPE = "https://meeservices.minecraft.net/.default offline_access openid profile";
+
+    static EduAuth& instance();
+
+    // Returns a valid access token, refreshing or asking the user to sign in when needed.
+    // Throws std::runtime_error with a user facing message on failure.
+    std::string acquireToken(bool allowInteractive);
+
+    void signOut();
+
+private:
+    std::mutex mutex;
+    std::string accessToken;
+    std::string refreshToken;
+    long long expiresAt = 0;
+    bool loaded = false;
+
+    std::string cachePath();
+    void load();
+    void save();
+    void applyTokenResponse(std::string const& body);
+    void redeemRefreshToken();
+    void interactiveSignIn();
+    std::string showSignInWindow(std::string const& url);
+};

+
 size_t NativeInputStream::Read(void *buffer, size_t size) {
+    if(eduUrl.empty()) {
+        return ReadRaw(buffer, size);
+    }
+    if(!eduLoaded) {
+        eduLoaded = true;
+        std::vector<char> chunk(16384);
+        while((FakeJni::JLong)eduBody.size() < eduLength) {
+            auto r = ReadRaw(chunk.data(), chunk.size());
+            if(r == (size_t)-1 || r == 0) {
+                break;
+            }
+            eduBody.append(chunk.data(), r);
+        }
+        eduBody = EduSupport::rewriteRequestBody(eduUrl, eduBody, (size_t)eduLength);
+    }
+    if(eduPos >= eduBody.size()) {
+        return 0;
+    }
+    auto n = std::min(size, eduBody.size() - eduPos);
+    memcpy(buffer, eduBody.data() + eduPos, n);
+    eduPos += n;
+    return n;
+}

+#include <ctime>
+#include <unistd.h>
+
+// com.microsoft.authentication.Status ordinals
+enum OneAuthStatus { STATUS_UNEXPECTED = 0, STATUS_INTERACTION_REQUIRED = 2, STATUS_NO_NETWORK = 3 };
+
+static std::string str(std::shared_ptr<FakeJni::JString> const& s) {
+    return s ? s->asStdString() : std::string();
+}
+
+template<class T>
+static void callVoid(FakeJni::Jvm const* vm, std::shared_ptr<T> const& self, char const* name) {
+    FakeJni::LocalFrame env(*vm);
+    auto cb = self->getClass().getMethod("()V", name);
+    if(cb)
+        cb->invoke(env.getJniEnv(), self.get());
+    else
+        Log::error("EduAuth", "%s is not registered", name);
+}
+
+std::shared_ptr<ActiveDirectorySignIn> ActiveDirectorySignIn::createActiveDirectorySignIn() {
+    return std::make_shared<ActiveDirectorySignIn>();
+}
+
+void ActiveDirectorySignIn::signIn(bool interactive, std::string target, std::string hint) {
+    cancelled = false;
+    FakeJni::Jvm const* vm = &FakeJni::JniEnv::getCurrentEnv()->getVM();
+    auto self = std::static_pointer_cast<ActiveDirectorySignIn>(shared_from_this());
+    std::thread([vm, self, interactive, target, hint]() {
+        try {
+            auto token = EduAuth::instance().acquireToken(interactive, target, hint);
+            self->accessToken = token.accessToken;
+            self->expiresOn = token.expiresAt;
+            auto user = EduAuth::instance().userName();
+            self->userHint = user.empty() ? hint : user;
+            self->error = false;
+            self->errorString.clear();
+            self->errorStatus = -1;
+            Log::info("EduAuth", "Signed in as %s", self->userHint.c_str());
+        } catch(EduAuth::Cancelled& e) {
+            self->cancelled = true;
+            self->error = false;
+            self->userHint = hint;
+            Log::info("EduAuth", "Sign-in cancelled");
+        } catch(EduAuth::InteractionRequired& e) {
+            self->error = true;
+            self->errorString = e.what();
+            self->errorStatus = STATUS_INTERACTION_REQUIRED;
+            Log::info("EduAuth", "Silent sign-in needs the user: %s", e.what());
+        } catch(std::exception& e) {
+            self->error = true;
+            self->errorString = e.what();
+            self->errorStatus = std::string(e.what()).find("Network error") != std::string::npos ? STATUS_NO_NETWORK : STATUS_UNEXPECTED;
+            Log::error("EduAuth", "Sign-in failed: %s", e.what());
+        }
+        callVoid(vm, self, "nativeOnDataChanged");
+    }).detach();
+}
+
+void ActiveDirectorySignIn::authenticate(std::shared_ptr<FakeJni::JString> userHint, FakeJni::JInt promptBehavior) {
+    Log::info("EduAuth", "authenticate(%s, %d)", str(userHint).c_str(), (int)promptBehavior);
+    signIn(true, {}, str(userHint));
+}
+
+void ActiveDirectorySignIn::silentSignin(std::shared_ptr<FakeJni::JString> userHint, std::shared_ptr<FakeJni::JString> target) {
+    Log::info("EduAuth", "silentSignin(%s, %s)", str(userHint).c_str(), str(target).c_str());
+    signIn(false, str(target), str(userHint));
+}
+
+void ActiveDirectorySignIn::signOut() {
+    Log::info("EduAuth", "signOut()");
+    EduAuth::instance().signOut();
+    signOutError.clear();
+    FakeJni::Jvm const* vm = &FakeJni::JniEnv::getCurrentEnv()->getVM();
+    auto self = shared_from_this();
+    std::thread([vm, self]() { callVoid(vm, self, "nativeOnSignOutCallback"); }).detach();
+}
+
+void ActiveDirectorySignIn::clearCookies() {
+    // The sign-in window keeps its own cookies, "edulauncher signout" clears them
+}
+
+std::shared_ptr<FakeJni::JString> ActiveDirectorySignIn::getAccessToken() {
+    return std::make_shared<FakeJni::JString>(accessToken);
+}
+
+FakeJni::JLong ActiveDirectorySignIn::getExpiresOn() {
+    return expiresOn;
+}
+
+std::shared_ptr<FakeJni::JString> ActiveDirectorySignIn::getUserHint() {
+    return std::make_shared<FakeJni::JString>(userHint);
+}
+
+FakeJni::JBoolean ActiveDirectorySignIn::getCancelled() {
+    return cancelled;
+}
+
+FakeJni::JBoolean ActiveDirectorySignIn::hasError() {
+    return error;
+}
+
+std::shared_ptr<FakeJni::JString> ActiveDirectorySignIn::getErrorString() {
+    return std::make_shared<FakeJni::JString>(errorString);
+}
+
+FakeJni::JInt ActiveDirectorySignIn::getErrorStatus() {
+    return errorStatus;
+}
+
+FakeJni::JInt ActiveDirectorySignIn::getErrorSubStatus() {
+    return error ? 0 : -1;
+}
+
+std::shared_ptr<FakeJni::JString> ActiveDirectorySignIn::getSignOutError() {
+    return std::make_shared<FakeJni::JString>(signOutError);
+}
+
+std::shared_ptr<FakeJni::JString> ActiveDirectorySignIn::getLastError() {
+    return std::make_shared<FakeJni::JString>(errorString);
+}
+
+namespace EduSupport {
+
+static std::mutex storageMutex;
+static nlohmann::json storage;
+static bool storageLoaded = false;
+
+static std::string storagePath() {
+    return PathHelper::getPrimaryDataDirectory() + "edu_secure_storage.json";
+}
+
+static void loadStorage() {
+    if(storageLoaded)
+        return;
+    storageLoaded = true;
+    storage = nlohmann::json::object();
+    std::ifstream f(storagePath());
+    if(f) {
+        try {
+            storage = nlohmann::json::parse(f);
+        } catch(...) {
+            storage = nlohmann::json::object();
+        }
+    }
+}
+
+std::string getSecureStorageKey(std::string const& key) {
+    std::lock_guard<std::mutex> lock(storageMutex);
+    loadStorage();
+    auto it = storage.find(key);
+    return it != storage.end() && it->is_string() ? it->get<std::string>() : std::string();
+}
+
+void setSecureStorageKey(std::string const& key, std::string const& value) {
+    std::lock_guard<std::mutex> lock(storageMutex);
+    loadStorage();
+    storage[key] = value;
+    auto path = storagePath();
+    {
+        std::ofstream f(path, std::ios::trunc);
+        f << storage.dump();
+    }
+    chmod(path.c_str(), 0600);
+}
+
+bool isEduServiceUrl(std::string const& url) {
+    auto scheme = url.find("://");
+    if(scheme == std::string::npos)
+        return false;
+    auto hostStart = scheme + 3;
+    auto host = url.substr(hostStart, url.find_first_of("/:?", hostStart) - hostStart);
+    static const std::string suffix = "minecrafteduservices.com";
+    return host.size() >= suffix.size() && host.compare(host.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+std::string rewriteRequestBody(std::string const& url, std::string const& body, size_t maxSize) {
+    nlohmann::json js;
+    try {
+        js = nlohmann::json::parse(body);
+    } catch(...) {
+        return body;
+    }
+    if(!js.is_object() || !js.contains("platform") || !js.contains("osVersion"))
+        return body;
+    auto envPlatform = getenv("MCEE_PLATFORM");
+    std::string platform = envPlatform ? envPlatform : "Nokia8(Android)(x64)";
+    Log::info("EduHttp", "Reporting platform %s instead of %s to %s", platform.c_str(), js["platform"].dump().c_str(), url.c_str());
+    js["platform"] = platform;
+    js["osVersion"] = "10.0.0";
+    js["platformCategory"] = "mobile";
+    js.erase("requestId");
+    js.erase("correlationVector");
+    auto out = js.dump();
+    if(maxSize) {
+        if(out.size() > maxSize) {
+            Log::warn("EduHttp", "Rewritten body does not fit the announced size, sending the original");
+            return body;
+        }
+        // Content-Length was already announced, trailing whitespace keeps the JSON valid
+        out.resize(maxSize, ' ');
+    }
+    return out;
+}
+
+void addGameHooks(std::vector<mcpelauncher_hook_t>& hooks) {
+    // The telemetry uploader crashes the game shortly after start without the Android services it expects
+    hooks.emplace_back(mcpelauncher_hook_t{"_ZN9Microsoft12Applications6Events15StorageObserver20handleRetrieveEventsERKNSt6__ndk110shared_ptrINS1_19EventsUploadContextEEE",
+                                           (void*)+[]() {
+                                               for(;;)
+                                                   std::this_thread::sleep_for(std::chrono::hours(24));
+                                           }});
+}
+
+// MCEE_DUMP_SYMBOLS=<file> lists the symbols each fake library offers, to find what a new game version is missing
+static void dumpSymbols(char const* lib, std::unordered_map<std::string, void*> const& syms) {
+    auto path = getenv("MCEE_DUMP_SYMBOLS");
+    if(!path)
+        return;
+    std::ofstream f(path, std::ios::app);
+    for(auto& s : syms)
+        f << lib << " " << s.first << "\n";
+}
+
+void addLibCSymbols(std::unordered_map<std::string, void*>& syms) {
+    // Signals are not forwarded to the game (see sigprocmask in libc-shim), and bionic's sigset_t is smaller than glibc's
+    syms.emplace("pthread_sigmask", (void*)+[](int, void const*, void*) -> int { return 0; });
+    // Same layout in bionic and glibc on x86_64
+    syms.emplace("ldiv", (void*)::ldiv);
+    syms.emplace("getentropy", (void*)::getentropy);
+    syms.emplace("timegm", (void*)::timegm);
+    dumpSymbols("libc", syms);
+}
+
+void addAndroidSymbols(std::unordered_map<std::string, void*>& syms) {
+    // No performance hint service, the game checks for a null manager
+    syms.emplace("APerformanceHint_getManager", (void*)+[]() -> void* { return nullptr; });
+    syms.emplace("APerformanceHint_createSession", (void*)+[](void*, int32_t const*, size_t, int64_t) -> void* { return nullptr; });
+    syms.emplace("APerformanceHint_reportActualWorkDuration", (void*)+[](void*, int64_t) -> int { return 0; });
+    syms.emplace("APerformanceHint_updateTargetWorkDuration", (void*)+[](void*, int64_t) -> int { return 0; });
+    syms.emplace("APerformanceHint_closeSession", (void*)+[](void*) {});
+    syms.emplace("ALooper_acquire", (void*)+[](void*) {});
+    syms.emplace("ALooper_release", (void*)+[](void*) {});
+    syms.emplace("ALooper_wake", (void*)+[](void*) {});
+    syms.emplace("ALooper_removeFd", (void*)+[](void*, int) -> int { return 0; });
+    syms.emplace("ANativeWindow_acquire", (void*)+[](void*) {});
+    syms.emplace("ANativeWindow_release", (void*)+[](void*) {});
+    syms.emplace("ANativeWindow_fromSurface", (void*)+[](void*, void*) -> void* { return nullptr; });
+    syms.emplace("ANativeWindow_setBuffersGeometry", (void*)+[](void*, int32_t, int32_t, int32_t) -> int32_t { return 0; });
+    dumpSymbols("libandroid", syms);
+}
+
+}  // namespace EduSupport
